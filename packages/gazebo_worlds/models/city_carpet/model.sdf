<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="city_carpet">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 1.5705 0</pose>
      <must_be_base_link>1</must_be_base_link>
      <collision name="collision">
         <geometry>
           <box>
             <size>2. 2. 0.005</size>  <!-- adjust this to whatever you want -->
          </box>
         </geometry>
       </collision>
       <visual name="visual">
           <cast_shadows>false</cast_shadows>
           <geometry>
             <box>
                <size>2. 2. 0.005</size>  <!-- same size as collision -->
            </box>
          </geometry>
          <material>
            <script>
            <uri>model://city_carpet/materials/scripts</uri>
            <uri>model://city_carpet/materials/textures</uri>
            <name>city_carpet/Image</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
