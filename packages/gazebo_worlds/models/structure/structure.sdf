<sdf version="1.4">
  <model name="structure">
    <static>true</static> <!-- Set to false if you want it to be movable -->
    
    <link name="structure_link">
      <visual name="structure_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://structure/structure.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="colision">
        <geometry>
          <mesh>
            <uri>model://structure/structure.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0xffff</collide_bitmask>
            <ode>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1000</mu>
              <mu2>500</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0</threshold>
          </bounce>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
