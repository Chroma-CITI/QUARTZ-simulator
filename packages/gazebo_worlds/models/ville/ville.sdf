<sdf version="1.4">
  <model name="Ville">
    <static>true</static> <!-- Set to false if you want it to be movable -->
    
    <link name="Ville_link">
      <visual name="Ville_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ville/ville.dae</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="colision">
        <geometry>
          <mesh>
            <uri>model://ville/ville.dae</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0xffff</collide_bitmask>
            <ode>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1000</mu>
              <mu2>500</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0</threshold>
          </bounce>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
