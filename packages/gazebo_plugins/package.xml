<?xml version="1.0"?>
<package format="2">
  <name>chroma_gazebo_plugins</name>
  <version>1.0.0</version>
  <description>The chroma_gazebo_plugins package</description>
  <maintainer email="vincent.le-doze@inria.fr">Vincent LE DOZE</maintainer>
  <author>Vincent LE DOZE</author>
  <license>ASL 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>>

  <!-- Dependencies needed to compile & run this package. -->
  <depend>cmake_modules</depend>
  <depend>roscpp</depend>
  <depend>rosbag</depend>
  <depend>tf</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>

  <depend>mavros</depend>
  <depend>octomap</depend>
  <depend>octomap_ros</depend>
  <depend>octomap_msgs</depend>
  <depend>octomap_server</depend>


  <depend>chroma_gazebo_plugins_msgs</depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->
    <gazebo_ros plugin_path="${prefix}/lib" gazebo_media_path="${prefix}" gazebo_model_path="${prefix}/models"/>
  </export>

</package>
