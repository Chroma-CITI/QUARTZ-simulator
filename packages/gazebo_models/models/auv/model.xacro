<?xml version="1.0"?>

<robot name="auv" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Properties -->
    <xacro:property name="namespace" value="$(arg namespace)"/>

    <xacro:property name="body_mesh_visual"    value=" "/>
    <xacro:property name="body_mesh_collision" value=" "/>
    <xacro:property name="body_mass"           value="8.0"/> <!-- [kg] -->
    <xacro:property name="body_lx"             value="0.485"/> <!-- [m] -->
    <xacro:property name="body_ly"             value="0.257"/> <!-- [m] -->
    <xacro:property name="body_lz"             value="0.354"/> <!-- [m] -->

    <!-- fichiers inclus  -->
    <xacro:include filename="$(find chroma_gazebo_models)/models/auv/base.xacro"/>
    <xacro:include filename="$(find chroma_gazebo_models)/models/auv/sensors.xacro"/>

</robot>
