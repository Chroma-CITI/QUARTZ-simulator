<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Property Blocks BODY-->
  <xacro:property name="body_mass"   value="0.033"/> <!-- [kg] -->
  <xacro:property name="body_lx"     value="0.02"/>   <!-- [m] -->
  <xacro:property name="body_ly"     value="0.02"/>   <!-- [m] -->
  <xacro:property name="body_lz"     value="0.05"/>  <!-- [m] -->
  <xacro:property name="body_inertia">
    <inertia
      ixx="${1/12 * body_mass * (body_ly*body_ly + body_lz*body_lz)}"
      iyy="${1/12 * body_mass * (body_lx*body_lx + body_lz*body_lz)}"
      izz="${1/12 * body_mass * (body_lx*body_lx + body_ly*body_ly)}"
      ixy="0.0" ixz="0.0"  iyz="0.0" />
  </xacro:property>

  <!-- Property Blocks BATTERY-->
  <xacro:property name="battery_lx"     value="0.05"/>   <!-- [m] -->
  <xacro:property name="battery_ly"     value="0.05"/>   <!-- [m] -->
  <xacro:property name="battery_lz"     value="0.02"/>  <!-- [m] -->

  <!-- Property Blocks ROTOR-->
  <xacro:property name="rotor_mass" value="0.002"/> <!-- [kg] -->
  <xacro:property name="rotor_radius" value="0.045"/> <!-- [m] -->
  <xacro:property name="rotor_height" value="0.02"/> <!-- [m] -->
  <xacro:property name="rotor_bodyspeed_max" value="25.0" /> <!-- [rad/s] -->
  <xacro:property name="rotor_rotorspeed_max" value="1400.0"/> <!-- [rad/s] -->
  <xacro:property name="rotor_velocity_slowdown_sim" value="10"/>
  <xacro:property name="rotor_thrust_constant" value="2.39e-05"/> <!-- [kg.m/s^2] -->
  <xacro:property name="rotor_torque_constant" value="${0.016*2.39e-05}"/> <!-- [m] -->
  <xacro:property name="rotor_drag_coefficient" value="0.0"/>
  <xacro:property name="rotor_moment_coefficient" value="0.0"/>
  <xacro:property name="rotor_filter_time_constant_up" value="0.0015"/> <!-- [s] -->
  <xacro:property name="rotor_filter_time_constant_down" value="0.0015"/> <!-- [s] -->
  <xacro:property name="rotor_inertia">  <!-- [kg.m^2] [kg.m^2] [kg.m^2] [kg.m^2] [kg.m^2] [kg.m^2] -->
    <inertia
      ixx="${1/12*rotor_mass*(3*rotor_radius*rotor_radius + rotor_height*rotor_height) * rotor_velocity_slowdown_sim}"
      iyy="${1/12*rotor_mass*(3*rotor_radius*rotor_radius + rotor_height*rotor_height) * rotor_velocity_slowdown_sim}"
      izz="${1/2*rotor_mass*rotor_radius*rotor_radius * rotor_velocity_slowdown_sim}"
      ixy="0.0" ixz="0.0"  iyz="0.0" />
  </xacro:property>

  <!-- Variable -->
  <xacro:property name="body_pz"     value="${battery_lz + rotor_height + body_lz/2.0}"/>  <!-- [m] -->

  <!-- Included URDF Files -->
  <xacro:include filename="$(find chroma_gazebo_models)/macros/parts/body_uav_macro.xacro"/>
  <xacro:include filename="$(find chroma_gazebo_models)/macros/parts/battery_macro.xacro"/>
  <xacro:include filename="$(find chroma_gazebo_models)/macros/parts/rotor_macro.xacro"/>

  <!-- Instantiate body_uav_macro once -->
  <xacro:body_uav_macro
    robot_namespace="${namespace}"
    mass="${body_mass}"
    length="${body_lx}"
    width="${body_ly}"
    height="${body_lz}"
    mesh_file=" ">
    <origin xyz="0.0 0.0 ${body_pz}" rpy="0.0 0.0 0.0" />
    <xacro:insert_block name="body_inertia" />
  </xacro:body_uav_macro>

  <!-- Battery -->
  <xacro:battery_macro
    robot_namespace="${namespace}"
    parent_link="${namespace}/base_link"
    mass="0.1"
    lx="${battery_lx}"
    ly="${battery_ly}"
    lz="${battery_lz}">
    <origin xyz="0.0 0.0 ${battery_lz/2.0}" rpy="0.0 0.0 0.0" />
  </xacro:battery_macro>

  <!-- Upper rotor -->
  <xacro:rotor_macro
    robot_namespace="${namespace}"
    parent_link="${namespace}/base_link"
    id="0"
    direction="ccw"
    mass="${rotor_mass}"
    radius="${rotor_radius}"
    height="${rotor_height}"
    velocity_slowdown_sim="${rotor_velocity_slowdown_sim}"
    filter_time_constant_up="${rotor_filter_time_constant_up}"
    filter_time_constant_down="${rotor_filter_time_constant_down}"
    bodyspeed_max="${rotor_bodyspeed_max}"
    rotorspeed_max="${rotor_rotorspeed_max}"
    thrust_constant="${rotor_thrust_constant}"
    torque_constant="${rotor_torque_constant}"
    drag_coefficient="${rotor_drag_coefficient}"
    moment_coefficient="${rotor_moment_coefficient}"
    mesh_file ="default_propeller_5x3_ccw.dae">
    <origin xyz="0.0 0.0 ${body_pz + body_lz/2.0 + rotor_height/2.0}" rpy="0.0 0.0 0.0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:rotor_macro>

  <!-- Lower rotor -->
  <xacro:rotor_macro
    robot_namespace="${namespace}"
    parent_link="${namespace}/base_link"
    id="1"
    direction="cw"
    mass="${rotor_mass}"
    radius="${rotor_radius}"
    height="${rotor_height}"
    velocity_slowdown_sim="${rotor_velocity_slowdown_sim}"
    filter_time_constant_up="${rotor_filter_time_constant_up}"
    filter_time_constant_down="${rotor_filter_time_constant_down}"
    bodyspeed_max="${rotor_bodyspeed_max}"
    rotorspeed_max="${rotor_rotorspeed_max}"
    thrust_constant="${rotor_thrust_constant}"
    torque_constant="${rotor_torque_constant}"
    drag_coefficient="${rotor_drag_coefficient}"
    moment_coefficient="${rotor_moment_coefficient}"
    mesh_file ="default_propeller_5x3_cw.dae">
    <origin xyz="0.0 0.0 ${body_pz - body_lz/2.0 - rotor_height/2.0}" rpy="0.0 0.0 0.0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:rotor_macro>

  <!-- Forward rotor -->
  <xacro:rotor_macro
    robot_namespace="${namespace}"
    parent_link="${namespace}/base_link"
    id="2"
    direction="cw"
    mass="0.0005"
    radius="0.015"
    height="0.003"
    velocity_slowdown_sim="${rotor_velocity_slowdown_sim}"
    filter_time_constant_up="${rotor_filter_time_constant_up}"
    filter_time_constant_down="${rotor_filter_time_constant_down}"
    bodyspeed_max="${rotor_bodyspeed_max}"
    rotorspeed_max="${rotor_rotorspeed_max}"
    thrust_constant="${rotor_thrust_constant}"
    torque_constant="${rotor_torque_constant}"
    drag_coefficient="${rotor_drag_coefficient}"
    moment_coefficient="${rotor_moment_coefficient}"
    mesh_file ="default_propeller_1.5x0.75_cw.dae">
    <origin xyz="${body_lx/2.0 + 0.003} 0.0 ${body_pz}" rpy="0.0 1.57 0.0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:rotor_macro>

</robot>
