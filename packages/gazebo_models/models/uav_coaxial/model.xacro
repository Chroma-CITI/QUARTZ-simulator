<?xml version="1.0"?>

<robot name="uav_coaxial" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Properties -->
    <xacro:property name="namespace" value="$(arg namespace)"/>

    <!-- fichiers inclus  -->
    <xacro:include filename="$(find chroma_gazebo_models)/models/uav_coaxial/base.xacro"/>
    <xacro:include filename="$(find chroma_gazebo_models)/models/uav_coaxial/sensors.xacro"/>

</robot>
