<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="oa_laserscan_macro"
    params="
      robot_namespace
      parent_link
      name
      size_x
      size_y
      size_z
      update_rate
      ray_count_h
      min_angle_h
      max_angle_h
      ray_count_v
      min_angle_v
      max_angle_v
      range_max
      range_min
      noise
      *origin">

    <link name="${robot_namespace}/${name}_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="1e-5" />
          <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <box size="${size_x} ${size_y} ${size_z}" />
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <box size="${size_x} ${size_y} ${size_z}" />
          </geometry>
        </collision>
    </link>

    <joint name="${robot_namespace}_${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent_link}"/>
      <child link="${robot_namespace}/${name}_link"/>
    </joint>

    <gazebo reference="${robot_namespace}/${name}_link">
      <sensor type="ray" name="${name}">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>${ray_count_h}</samples>
              <!-- Resolution is multiplied by samples to determine number of
                   simulated beams vs interpolated beams. See:
                   http://sdformat.org/spec?ver=1.6&elem=sensor#horizontal_resolution -->
              <resolution>1</resolution>
              <min_angle>${min_angle_h}</min_angle>
              <max_angle>${max_angle_h}</max_angle>
            </horizontal>
            <vertical>
              <samples>${ray_count_v}</samples>
              <!-- Resolution is multiplied by samples to determine number of
                   simulated beams vs interpolated beams. See:
                   http://sdformat.org/spec?ver=1.6&elem=sensor#horizontal_resolution -->
              <resolution>1</resolution>
              <min_angle>${min_angle_v}</min_angle>
              <max_angle>${max_angle_v}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>${noise}</mean>
            <stddev>0.01</stddev>
          </noise>  
        </ray>
        <plugin name="${robot_namespace}_${name}__plugin" filename="libgazebo_ros_laser.so">
          <topicName>${robot_namespace}/${name}/laser_scan</topicName>
          <framename>${robot_namespace}/${name}_link</framename>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
