<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="velodyn_macro"
    params="
      robot_namespace
      parent_link
      name
      visualization
      size_x
      size_y
      size_z
      update_rate
      mes_per_turn
      ray_count_h
      min_angle_h
      max_angle_h
      ray_count_v
      min_angle_v
      max_angle_v
      range_max
      range_min
      noise
      *origin">

    <xacro:property name="update_rate_laser" value="${mes_per_turn * update_rate}" />

    <link name="${robot_namespace}/${name}_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="1e-5" />
          <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <box size="${size_x} ${size_y} ${size_z}" />
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <box size="${size_x} ${size_y} ${size_z}" />
          </geometry>
        </collision>
    </link>

    <joint name="${robot_namespace}_${name}_joint" type="revolute">
      <xacro:insert_block name="origin" />
      <parent link="${parent_link}"/>
      <child link="${robot_namespace}/${name}_link"/>
      <!-- The axis defines the joint's degree of freedom -->
      <limit lower="-10000000000000000" upper="10000000000000000" effort="10" velocity="3"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${robot_namespace}/${name}_link">
      <sensor type="ray" name="${name}">
        <always_on>true</always_on>
        <update_rate>${update_rate_laser}</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <visualize>${visualization}</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>${ray_count_h}</samples>
              <!-- Resolution is multiplied by samples to determine number of
                   simulated beams vs interpolated beams. See:
                   http://sdformat.org/spec?ver=1.6&elem=sensor#horizontal_resolution -->
              <resolution>1</resolution>
              <min_angle>${min_angle_h}</min_angle>
              <max_angle>${max_angle_h}</max_angle>
            </horizontal>
            <vertical>
              <samples>${ray_count_v}</samples>
              <!-- Resolution is multiplied by samples to determine number of
                   simulated beams vs interpolated beams. See:
                   http://sdformat.org/spec?ver=1.6&elem=sensor#horizontal_resolution -->
              <resolution>1</resolution>
              <min_angle>${min_angle_v}</min_angle>
              <max_angle>${max_angle_v}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.001</resolution>
          </range>
        </ray>
        <plugin name="${robot_namespace}_${name}_plugin" filename="libgazebo_plugin__laserscan.so">
          <robot_namespace>${robot_namespace}</robot_namespace>
          <topic_name>${name}/laser_scan</topic_name>
          <frame_name>/${name}_link</frame_name>
          <resolution>0.001</resolution>
          <gaussian_noise>${noise}</gaussian_noise>
          <range_noise_slope>0.00127</range_noise_slope>  <!-- gives ~1.5cm at 10m -->
          <update_rate>${update_rate_laser}</update_rate>
          <interpolation>false</interpolation>
          <alwaysOn>true</alwaysOn>
        </plugin>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin
          name="${robot_namespace}_${name}_velodyn_plugin"
          filename="libgazebo_plugin__velodyn.so" >
        <robot_namespace>${robot_namespace}</robot_namespace>
        <joint_name>${robot_namespace}_${name}_joint</joint_name>
        <link_name>${robot_namespace}/${name}_link</link_name>
        <base_link_name>${parent_link}</base_link_name>
        <update_rate>${update_rate}</update_rate>
        <topic_velocity_cmd>${name}/vel_cmd</topic_velocity_cmd>
        <topic_laser_scan>${name}/laser_scan</topic_laser_scan>
        <topic_velodyn_scan>${name}/velodyn_scan</topic_velodyn_scan>
        <frame_velodyn_scan>/${name}_link</frame_velodyn_scan>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
