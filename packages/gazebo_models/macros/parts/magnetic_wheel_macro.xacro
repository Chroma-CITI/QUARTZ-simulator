<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">


  <!-- Rotor joint and link -->
  <xacro:macro name="magnetic_wheel_macro"
    params="
    robot_namespace
    parent_link
    name
    mass
    radius
    length
    force
    *origin
    *inertia
    *axis">

    <link name="${robot_namespace}/wheel_${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 1.5707 1.5707" />
        <mass value="${mass}" /> <!-- [kg] -->
        <xacro:insert_block name="inertia" />
      </inertial>

      <visual name="${robot_namespace}_wheel_${name}_visual">
        <origin xyz="0 0 0" rpy="0 1.5707 1.5707" />
        <geometry>
          <cylinder length="${length}" radius="${radius}" /> <!-- [m] -->
        </geometry>
      </visual>

      <collision name="${robot_namespace}_wheel_${name}_collision">
        <origin xyz="0 0 0" rpy="0 1.5707 1.5707" />
        <geometry>
          <cylinder length="${length}" radius="${radius}" /> <!-- [m] -->
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>0</threshold>
          </bounce>
          <contact>
            <ode>
              <max_vel>0</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="${robot_namespace}_wheel_${name}_joint" type="continuous">
      <xacro:insert_block name="origin" />
      <xacro:insert_block name="axis" />
      <parent link="${parent_link}" />
      <child link="${robot_namespace}/wheel_${name}_link" />
    </joint>

    <gazebo>
      <plugin
          filename="libgazebo_plugin__magnetic_wheel.so"
          name="${robot_namespace}_magnetic_wheel_plugin">
          <link_name>${robot_namespace}/wheel_${name}_link</link_name>
          <parent_link_name>${parent_link}</parent_link_name>
          <magnetic_force>${force}</magnetic_force>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
