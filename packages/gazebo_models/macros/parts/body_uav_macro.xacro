<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Main multirotor link -->
  <xacro:macro name="body_uav_macro"
    params="
    robot_namespace
    odom_freq
    mass
    length
    width
    height
    mesh_file
    *origin
    *inertia">

    <!-- Body frame -->
    <link name="${robot_namespace}/base_link">
      <inertial>
        <xacro:insert_block name="origin" />
        <mass value="${mass}" />  <!-- [kg] -->
        <xacro:insert_block name="inertia" />
      </inertial>

      <visual name="${robot_namespace}_body_visual">
        <xacro:insert_block name="origin" />
        <geometry>
          <xacro:if value="${mesh_file == ' '}">
            <box size="${length} ${width} ${height}" /> <!-- [m] [m] [m] -->
          </xacro:if>
          <xacro:unless value="${mesh_file == ' '}">
            <mesh filename="package://chroma_gazebo_models/meshes/${mesh_file}"/>
          </xacro:unless>
        </geometry>
      </visual>

      <collision name="${robot_namespace}_body_collision">
        <xacro:insert_block name="origin" />
        <geometry>
          <box size="${length} ${width} ${height}" /> <!-- [m] [m] [m] -->
        </geometry>
      </collision>
    </link>

    <gazebo>
      <plugin
            filename="libgazebo_plugin__body_uav.so"
            name="${robot_namespace}_body_uav_plugin">
          <robot_namespace>${robot_namespace}</robot_namespace>
          <link_name>${robot_namespace}/base_link</link_name>
          <frame_id>world</frame_id>
          <child_frame_id>${robot_namespace}/base_link</child_frame_id>
          <odom_freq>${odom_freq}</odom_freq>
          <radial_symmetry>false</radial_symmetry>
          <alpha_zero>0.0</alpha_zero>
          <area>${length * width}</area>
          <lift_coef_zero>0.0</lift_coef_zero>
          <drag_coef_zero>0.7</drag_coef_zero>
          <moment_coef_zero>0.0</moment_coef_zero>
          <alpha_stall>0.017</alpha_stall>
          <lift_coef_stall>0.0</lift_coef_stall>
          <drag_coef_stall>1.0</drag_coef_stall>
          <moment_coef_stall>0.0</moment_coef_stall>
          <center_of_pressure>0.0 0.0 0.0</center_of_pressure>
          <chord_direction>0.0 1.0 0.0</chord_direction>
      </plugin>
    </gazebo>
  </xacro:macro>
 </robot>
