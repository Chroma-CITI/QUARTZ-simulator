#!/bin/sh
# PX4 commands need the 'px4-' prefix in bash.
# (px4-alias.sh is expected to be in the PATH)
. px4-alias.sh

param select parameters.bson
param import

uorb start
param load
dataman start

param set MAV_SYS_ID 1
param set ATT_EXT_HDG_M 1
param set BAT1_N_CELLS 4
param set CAL_ACC0_ID 1376264
param set CAL_ACC0_XOFF 0.0
param set CAL_ACC0_XSCALE 1.01
param set CAL_ACC0_YOFF 0.0
param set CAL_ACC0_YSCALE 1.01
param set CAL_ACC0_ZOFF 0.0
param set CAL_ACC0_ZSCALE 1.01
param set CAL_ACC1_ID 1310728
param set CAL_ACC1_XOFF 0.01
param set CAL_GYRO0_ID 2293768
param set CAL_GYRO0_XOFF 0.0
param set CAL_GYRO0_YOFF 0.0
param set CAL_GYRO0_ZOFF 0.0
param set CAL_MAG0_ID 196616
param set CAL_MAG0_ROT 0
param set CAL_MAG0_XOFF 0.01
param set COM_DISARM_LAND 3
param set COM_OBL_RC_ACT 4
param set COM_OF_LOSS_T 5
param set COM_RC_IN_MODE 1
param set EKF2_AID_MASK 29
param set EKF2_ANGERR_INIT 0.01
param set EKF2_GBIAS_INIT 0.01
param set EKF2_HGT_REF 1
param set EKF2_MAG_TYPE 0
param set EKF2_EVA_NOISE 0.0001
param set EKF2_EVP_NOISE 0.0001
param set FW_MAN_P_MAX 10.0
param set FW_MAN_R_MAX 10.0
param set MAV_TYPE 2
param set MAV_1_BROADCAST 1
param set MC_PITCH_P 1.0
param set MC_PITCHRATE_P 0.5
param set MC_PITCHRATE_I 0.0
param set MC_PITCHRATE_D 0.0
param set MC_PITCHRATE_FF 0.0
param set MC_ROLL_P 1.0
param set MC_ROLLRATE_P 0.5
param set MC_ROLLRATE_I 0.0
param set MC_ROLLRATE_D 0.0
param set MC_ROLLRATE_FF 0.0
param set MC_YAW_P 0.5
param set MC_YAWRATE_P 0.2
param set MC_YAWRATE_I 0.0
param set MC_YAWRATE_D 0.0
param set MPC_XY_P 0.4
#param set MPC_XY_VEL_P_ACC 0.1
#param set MPC_XY_VEL_I_ACC 0.01
#param set MPC_XY_VEL_D_ACC 0.01
param set MPC_Z_P 1.2
#param set MPC_Z_VEL_P 0.1
#param set MPC_Z_VEL_I 0.01
#param set MPC_Z_VEL_D 0.005
param set MPC_HOLD_MAX_Z 2.0
param set MIS_TAKEOFF_ALT 2.0
param set NAV_ACC_RAD 2.0
param set NAV_DLL_ACT 2
param set RTL_DESCEND_ALT 5.0
param set RTL_LAND_DELAY 5
param set RTL_RETURN_ALT 30.0
param set SDLOG_DIRS_MAX 7
param set SENS_BOARD_ROT 0
param set SENS_BOARD_X_OFF 0.000001
#param set SYS_AUTOSTART 10040
param set SYS_AUTOSTART 1010
param set SYS_MC_EST_GROUP 2
param set MAV_PROTO_VER 2
param set MAV_1_UDP_PRT 14560
param set SYS_AUTOCONFIG 1
param set SYS_HITL 2

if ! replay tryapplyparams
then
	simulator_sih start
	sensor_baro_sim start
	sensor_mag_sim start
	sensor_gps_sim start
fi
tone_alarm start
pwm_out_sim start
sensors start
commander start
land_detector start multicopter
navigator start
ekf2 start
mc_pos_control start
mc_att_control start
mc_rate_control start

#mixer load /dev/pwm_output0 ROMFS/px4fmu_common/mixers/quad_w.main.mix
mavlink start -x -u 14556 -r 4000000 -f
mavlink start -x -u 14580 -r 4000000 -f -m onboard -o 14540
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u 14556
mavlink stream -r 50 -s LOCAL_POSITION_NED -u 14556
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u 14556
mavlink stream -r 50 -s ATTITUDE -u 14556
mavlink stream -r 50 -s ATTITUDE_QUATERNION -u 14556
mavlink stream -r 50 -s ATTITUDE_TARGET -u 14556
mavlink stream -r 50 -s SERVO_OUTPUT_RAW_0 -u 14556
mavlink stream -r 20 -s RC_CHANNELS -u 14556
mavlink stream -r 250 -s HIGHRES_IMU -u 14556
mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u 14556
logger start -e -t
mavlink boot_complete
replay trystart
